{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fields", "logsources"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["ocl", "type"],
        "properties": {"ocl": {"type": "string"}, "type": {"enum": ["string", "number"]}}
      }
    },
    "logsources": {
      "type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }
  }
}
